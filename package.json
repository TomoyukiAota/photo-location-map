{
  "name": "photo-location-map",
  "productName": "Photo Location Map",
  "version": "1.12.2-alpha",
  "description": "Display the locations where photos were taken on a map.",
  "homepage": "https://github.com/TomoyukiAota/photo-location-map",
  "author": {
    "name": "Tomoyuki Aota"
  },
  "main": "src-main/electron-main.js",
  "private": true,
  "config": {
    "devOrProd": "Dev"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "start": "npm-run-all -p ng:serve electron:live-reload",
    "build": "npm run build:src-main && npm run typecheck:build-config && ng build",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "build:src-main": "tsc -p tsconfig.src-main.json",
    "ng:serve": "ng serve -c production",
    "electron:live-reload": "wait-on http-get://localhost:4200/ && npm run build:src-main && electron . --live-reload",
    "electron:local": "npm run build:prod && electron .",
    "electron-builder:linux": "npm run build:prod && electron-builder build --linux",
    "electron-builder:mac": "npm run build:prod && electron-builder build --mac",
    "electron-builder:windows": "npm run build:prod && electron-builder build --windows",
    "package:linux": "npm run electron-builder:linux -- --publish never",
    "package:mac": "npm run electron-builder:mac -- --publish never",
    "package:windows": "npm run electron-builder:windows -- --publish never",
    "publish:linux": "node ./script/publish/run-publish.js linux",
    "publish:mac": "node ./script/publish/run-publish.js mac",
    "publish:windows": "node ./script/publish/run-publish.js windows",
    "notarytool:history": "node script/notarize/xcrun-notarytool-history.js",
    "notarytool:log": "node script/notarize/xcrun-notarytool-log.js",
    "lint:ng": "ng lint",
    "lint:ng:fix": "ng lint --fix",
    "lint:script": "eslint -c ./script/eslint.config.mjs ./script/**/*.js",
    "lint:script:fix": "npm run lint:script -- --fix",
    "lint:all": "npm-run-all lint:ng lint:script",
    "test:unit:ng": "ng test --watch=false",
    "test:unit:ng:watch": "ng test --watch",
    "test:unit:ng:coverage": "ng test --code-coverage",
    "test:unit:em:main": "cross-env TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=./test/em-main.tsconfig.json PLM_EM_MAIN=true electron-mocha --config ./test/em-main.mocharc.js",
    "test:unit:em:renderer": "cross-env TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=./test/em-renderer.tsconfig.json PLM_EM_RENDERER=true electron-mocha --renderer --require-main ./test/em-renderer-require-in-main-process.js --window-config ./test/em-renderer-window-config.js --config ./test/em-renderer.mocharc.js",
    "test:unit:em:both": "npm-run-all test:unit:em:main test:unit:em:renderer",
    "test:unit:em:help": "electron-mocha --help",
    "test:unit:all": "npm-run-all test:unit:ng test:unit:em:both",
    "test:package": "cross-env PLM_PACKAGE_TEST=true node ./script/package-test/run-package-test.js",
    "test:all": "npm-run-all lint:all test:unit:all test:package",
    "check": "npm-check --skip-unused --save-exact --update",
    "test:e2e": "playwright test -c test/e2e/playwright.config.mjs",
    "verify:runtime": "node script/verify-runtime.js",
    "typecheck:build-config": "tsc -p tsconfig.build-config.json",
    "verify:electron": "node script/verify-runtime.js --electron"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "async": "3.2.6",
    "commander": "15.0.0",
    "delete-empty": "3.0.0",
    "directory-tree": "3.6.0",
    "electron-unhandled": "4.0.1",
    "electron-updater": "6.8.12",
    "electron-window-state": "5.0.3",
    "exifr": "7.1.3",
    "fs-extra": "11.4.1",
    "heic-decode": "2.0.0",
    "is-natural-number": "4.0.1",
    "is-number": "7.0.0",
    "jimp": "0.16.2",
    "jpeg-js": "0.4.4",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "moment-duration-format": "2.3.2",
    "moment-timezone": "0.6.6",
    "physical-cpu-count": "2.0.0",
    "promise.allsettled": "1.0.6",
    "rage-edit": "1.2.0",
    "tiny-worker": "2.3.0",
    "uuid": "14.0.3",
    "workerpool": "6.3.1"
  },
  "devDependencies": {
    "@amplitude/analytics-browser": "1.6.7",
    "@angular-builders/custom-webpack": "22.0.1",
    "@angular-devkit/build-angular": "22.2.5",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@electron/notarize": "3.1.2",
    "@eslint/js": "9.39.5",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "@stylistic/eslint-plugin": "2.8.0",
    "@turf/turf": "6.5.0",
    "@types/async": "3.2.26",
    "@types/delete-empty": "3.0.5",
    "@types/fs-extra": "11.0.4",
    "@types/is-natural-number": "4.0.4",
    "@types/is-number": "7.0.5",
    "@types/jasmine": "5.1.4",
    "@types/leaflet": "1.9.0",
    "@types/leaflet.markercluster": "1.5.1",
    "@types/lodash": "4.17.27",
    "@types/mixpanel-browser": "2.38.0",
    "@types/moment-duration-format": "2.2.7",
    "@types/node": "24.19.2",
    "@types/promise.allsettled": "1.0.3",
    "@types/webpack": "5.28.0",
    "@types/workerpool": "6.1.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "angular-eslint": "22.6.0",
    "chai": "4.3.7",
    "comlink": "4.4.2",
    "cross-env": "7.0.3",
    "echarts": "5.4.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "electron-mocha": "13.1.0",
    "electron-reload": "1.5.0",
    "eslint": "9.39.5",
    "espower-typescript": "10.0.1",
    "exif-parser": "0.1.12",
    "jasmine-core": "5.2.0",
    "jsonc-parser": "3.3.1",
    "karma": "6.4.4",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-electron": "7.3.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "karma-mocha-reporter": "2.2.5",
    "mixpanel-browser": "2.45.0",
    "ng-mocks": "14.18.4",
    "ng-table-virtual-scroll": "1.6.1",
    "ngx-echarts": "22.0.0",
    "npm-check": "6.0.1",
    "npm-run-all": "4.1.5",
    "p-queue": "9.3.5",
    "playwright": "1.64.1",
    "power-assert": "1.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "split.js": "1.6.5",
    "tree-kill": "1.2.2",
    "tslib": "2.7.0",
    "typescript": "6.0.3",
    "wait-on": "7.0.1",
    "zone.js": "0.16.3"
  },
  "browser": {
    "fs": false,
    "net": false,
    "tls": false
  },
  "engines": {
    "node": "26.x",
    "npm": "11.20.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@2.6.12": false,
    "es5-ext@0.10.62": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "electron-winstaller@5.4.0": false
  }
}

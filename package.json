{
  "name": "photo-location-map",
  "productName": "Photo Location Map",
  "version": "1.12.2-alpha",
  "description": "Display the locations where photos were taken on a map.",
  "homepage": "https://github.com/TomoyukiAota/photo-location-map",
  "author": {
    "name": "Tomoyuki Aota"
  },
  "main": "out/app/src-main/electron-main.js",
  "type": "module",
  "private": true,
  "config": {
    "devOrProd": "Dev"
  },
  "npm-run-all2": {
    "nodeRun": true
  },
  "scripts": {
    "postinstall": "node script/patch-electron-mocha.js && electron-builder install-app-deps",
    "ng": "ng",
    "start": "node script/build/remove-stale-output.js && npm-run-all -p ng:serve electron:live-reload",
    "build": "npm run build:src-main && npm run typecheck:build-config && ng build",
    "postbuild": "node script/build/preload-app-chunk.js",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "build:src-main": "node script/build/remove-stale-output.js out/app && tsc -p tsconfig.src-main.json",
    "ng:serve": "ng serve -c production",
    "electron:live-reload": "wait-on http-get://localhost:4200/ && npm run build:src-main && electron . --live-reload",
    "electron:local": "npm run build:prod && electron .",
    "electron-builder:linux": "npm run build:prod && electron-builder build --linux",
    "electron-builder:mac": "npm run build:prod && electron-builder build --mac",
    "electron-builder:windows": "npm run build:prod && electron-builder build --windows",
    "package:linux": "npm run electron-builder:linux -- --publish never",
    "package:mac": "npm run electron-builder:mac -- --publish never",
    "package:windows": "npm run electron-builder:windows -- --publish never",
    "publish:linux": "node ./script/publish/run-publish.js linux",
    "publish:mac": "node ./script/publish/run-publish.js mac",
    "publish:windows": "node ./script/publish/run-publish.js windows",
    "notarytool:history": "node script/notarize/xcrun-notarytool-history.js",
    "notarytool:log": "node script/notarize/xcrun-notarytool-log.js",
    "lint:ng": "ng lint",
    "lint:ng:fix": "ng lint --fix",
    "lint:main": "eslint \"src-main/**/*.ts\" \"src-shared/**/*.ts\"",
    "lint:script": "eslint -c ./script/eslint.config.mjs ./script/**/*.js",
    "lint:script:fix": "npm run lint:script -- --fix",
    "lint:all": "npm-run-all lint:ng lint:main lint:script",
    "test:unit:ng": "node script/build/remove-stale-output.js && ng test --watch=false",
    "test:unit:ng:watch": "node script/build/remove-stale-output.js && ng test --watch",
    "test:unit:ng:coverage": "node script/build/remove-stale-output.js && ng test --watch=false --coverage",
    "test:unit:em:build": "node script/build/remove-stale-output.js out/em && tsc -p test/em.tsconfig.json",
    "test:unit:em:main": "npm run test:unit:em:build && cross-env PLM_EM_MAIN=true electron-mocha --config ./test/em-main.mocharc.jsonc",
    "test:unit:em:renderer": "npm run test:unit:em:build && cross-env PLM_EM_RENDERER=true electron-mocha --renderer --require-main ./out/em/test/em-renderer-main-setup.js --preload ./electron-util/preload/main-window.cjs --window-config ./out/em/test/em-renderer-window-config.js --config ./test/em-renderer.mocharc.jsonc",
    "test:unit:em:both": "npm-run-all test:unit:em:main test:unit:em:renderer",
    "test:unit:em:help": "electron-mocha --help",
    "test:unit:all": "npm-run-all test:unit:ng test:unit:em:both",
    "test:package-runner": "node --test test/package-test/run.mjs test/package-test/minimum-system-version.mjs test/package-test/disk-image-tools.mjs test/package-test/electron-fuses.mjs",
    "test:package": "npm run test:package-runner && cross-env PLM_PACKAGE_TEST=true node ./script/package-test/run-package-test.js",
    "test:e2e": "playwright test -c test/e2e/playwright.config.mjs",
    "test:live-reload": "npm run build:src-main && node ./test/live-reload/run.mjs",
    "test:dependency-compat": "node --test test/deprecation-warnings/electron-mocha.mjs",
    "test:website": "node --test test/website/website-texts.mjs",
    "test:all": "npm-run-all lint:all test:dependency-compat test:website test:unit:all test:live-reload test:package",
    "check": "ncu --interactive --install always",
    "verify:runtime": "node script/verify-runtime.js",
    "typecheck:build-config": "tsc -p tsconfig.build-config.json",
    "verify:electron": "node script/verify-runtime.js --electron"
  },
  "dependencies": {
    "commander": "15.0.0",
    "directory-tree": "3.6.0",
    "electron-updater": "6.8.12",
    "electron-window-state": "5.0.3",
    "exifr": "7.1.3",
    "fs-extra": "11.4.1",
    "heic-decode": "2.1.0",
    "i18next": "27.0.1",
    "jimp": "1.6.1",
    "jpeg-js": "0.4.4",
    "lodash-es": "4.18.1",
    "moment": "2.31.0",
    "moment-duration-format": "2.3.2",
    "moment-timezone": "0.6.6",
    "physical-cpu-count": "2.0.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@amplitude/analytics-browser": "2.49.0",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.5",
    "@angular/cdk": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@electron/fuses": "1.8.0",
    "@electron/notarize": "3.1.2",
    "@eslint/js": "10.0.1",
    "@geoman-io/leaflet-geoman-free": "2.20.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@turf/turf": "7.4.0",
    "@types/fs-extra": "11.0.4",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/lodash-es": "4.17.12",
    "@types/moment-duration-format": "2.2.7",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "chokidar6": "npm:chokidar@6.0.0",
    "cross-env": "10.1.0",
    "echarts": "6.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "electron-mocha": "13.1.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "mixpanel-browser": "2.84.0",
    "ng-table-virtual-scroll": "1.6.1",
    "ngx-echarts": "22.0.0",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.4",
    "p-queue": "9.3.5",
    "playwright": "1.64.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "split.js": "1.6.5",
    "tree-kill": "1.2.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "browser": {
    "fs": false,
    "net": false,
    "tls": false
  },
  "engines": {
    "node": "26.x",
    "npm": "11.20.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "electron-winstaller@5.4.0": false
  }
}
